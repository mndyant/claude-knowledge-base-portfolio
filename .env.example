# 環境変数名の参考。このファイルを.envへコピーするだけでは読み込みません。
# 通常起動で回答生成を使う場合にプロセス環境変数として設定してください。
# 自作サンプル検索にはキー不要。実際の.envはGit管理外です。
GEMINI_API_KEY=your-gemini-api-key

# 任意のローカルdigest運用向け。公開用デモでは使用しません。
DISCORD_WEBHOOK_CLAUDE=

# テスト・CI用の軽量エンベディングモデル（任意・未設定時は multilingual-e5-base）
# EMBED_MODEL=paraphrase-MiniLM-L3-v2
